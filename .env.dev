# ─────────────────────────────────────────────────────────────────────────────
# Nyayrithm — DEVELOPMENT environment (committed; local use only).
#
# `make env` copies this to .env when .env does not exist. Put real secrets (LLM API
# keys) in .env, never here. Every credential below is a throwaway local value; none of
# it may be reused anywhere real. The backend refuses dev auth in production.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=development
DEBUG=true
SECRET_KEY=dev-only-secret-not-for-production

# ── Dev authentication ────────────────────────────
#   open         no login; API treats token-less requests as the seeded dev user
#                (firm owner of "Dev Firm" and platform admin)
#   credentials  real Keycloak login with the static accounts in keycloak/realm-dev.json
# Switch with: make dev (open)  |  make dev-creds (credentials)
DEV_AUTH_MODE=open
# Shown on the dev login screens in credentials mode (JSON; dev only)
DEV_ACCOUNTS_HINT='[{"role":"Platform admin","email":"platform.admin@nyayrithm.dev","password":"Admin#dev-2026"},{"role":"Firm owner","email":"owner@devfirm.nyayrithm.dev","password":"Owner#dev-2026"},{"role":"Attorney","email":"attorney@devfirm.nyayrithm.dev","password":"Attorney#dev-2026"}]'

# ── Public URLs ───────────────────────────────────
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:8000
WS_URL=ws://localhost:8000
KEYCLOAK_PUBLIC_URL=http://localhost:8080

# ── PostgreSQL ────────────────────────────────────
POSTGRES_DB=nyayrithm
POSTGRES_USER=nyayrithm
POSTGRES_PASSWORD=devpassword

# ── MongoDB ───────────────────────────────────────
MONGO_USER=nyayrithm
MONGO_PASSWORD=devpassword
MONGO_DB=nyayrithm

# ── Keycloak ──────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=admin

# ── Vector store / storage ────────────────────────
VECTOR_DB_BACKEND=qdrant
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/storage
MAX_UPLOAD_MB=100

# ── LLM + embeddings (put your key in .env) ───────
LLM_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDER_BACKEND=gemini
EMBEDDING_DIMENSION=768
SIMULATION_TURN_DELAY_SECONDS=7

# ── Legal accuracy ────────────────────────────────
LEGAL_REVIEW_ENABLED=true

# ── Email (dev: Mailpit at http://localhost:8025) ──
SMTP_FROM=no-reply@nyayrithm.dev
