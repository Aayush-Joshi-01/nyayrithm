# ─────────────────────────────────────────────────────────────────────────────
# Nyayrithm — PRODUCTION template. Copy to .env and fill every value.
#   docker compose up -d --build
# For local development use .env.dev instead (`make env` does this for you).
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=production
DEBUG=false
# Long random string. The backend refuses to start in production with the default.
SECRET_KEY=

# ── Public URLs (what browsers use) ───────────────
APP_URL=https://app.example.com
ADMIN_URL=https://admin.example.com
API_URL=https://api.example.com
WS_URL=wss://api.example.com
KEYCLOAK_PUBLIC_URL=https://auth.example.com

# ── PostgreSQL (firms, users, cases, simulations, audit chain) ──
POSTGRES_DB=nyayrithm
POSTGRES_USER=nyayrithm
POSTGRES_PASSWORD=

# ── MongoDB (turns, evidence text, LLM usage events) ──
MONGO_USER=nyayrithm
MONGO_PASSWORD=
MONGO_DB=nyayrithm

# ── Keycloak ──────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=

# ── Vector store / storage ────────────────────────
VECTOR_DB_BACKEND=qdrant
# local | s3 | minio   (s3/minio need AWS_*/S3_* below; minio runs with --profile s3)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/storage
MAX_UPLOAD_MB=100
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=nyayrithm-evidence
# S3_ENDPOINT_URL=

# ── LLM providers (at least one) ──────────────────
LLM_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://ollama:11434

# ── Embeddings: openai | gemini | sentence-transformers | local ──
EMBEDDER_BACKEND=gemini
EMBEDDING_DIMENSION=768
SIMULATION_TURN_DELAY_SECONDS=7

# ── Legal accuracy ────────────────────────────────
LEGAL_REVIEW_ENABLED=true
# Directory (inside the backend container) of extra jurisdiction packs
# LEGAL_PACKS_DIR=/app/legal-packs

# ── Email (invites). Required in production. ──────
SMTP_HOST=
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Never set in production (the backend refuses to start): DEV_AUTH_MODE, AUTH_DEV_BYPASS, SEED_DEV_DATA
