# ─────────────────────────────────────────
# Nyayrithm — Environment Configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────

# App
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=["http://localhost:3000"]

# ── Database ──────────────────────────────
# Options: postgres | mongodb | sqlite | dynamodb
DB_BACKEND=postgres
# Use localhost for native dev. docker-compose overrides this to "db:5432" automatically.
DATABASE_URL=postgresql+asyncpg://nyayrithm:secret@localhost:5432/nyayrithm

# MongoDB (if DB_BACKEND=mongodb)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=nyayrithm

# SQLite (if DB_BACKEND=sqlite — dev only)
SQLITE_PATH=./nyayrithm.db

# DynamoDB (if DB_BACKEND=dynamodb)
DYNAMODB_REGION=us-east-1
# DYNAMODB_ENDPOINT_URL=http://localhost:8000  # for local DynamoDB

# ── Vector DB ─────────────────────────────
# Options: qdrant | chroma | pinecone | weaviate | pgvector
VECTOR_DB_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Chroma (if VECTOR_DB_BACKEND=chroma)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Pinecone (if VECTOR_DB_BACKEND=pinecone)
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ── File Storage ──────────────────────────
# Options: local | s3 | minio | gcs | azure_blob
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage

# S3 / MinIO (if STORAGE_BACKEND=s3 or minio)
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=us-east-1
# S3_BUCKET=nyayrithm-evidence
# S3_ENDPOINT_URL=http://localhost:9000  # for MinIO

# ── Task Queue ────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_URL=redis://localhost:6379/2

# ── LLM Providers ─────────────────────────
# Default provider used when no role-specific override is set.
# The default agent roster targets the Gemini free tier — one key runs a full
# simulation at zero cost. Get a key at https://aistudio.google.com/app/apikey
LLM_DEFAULT_PROVIDER=gemini

GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Embedder ──────────────────────────────
# Options: openai | cohere | gemini | sentence-transformers | local
# sentence-transformers runs locally with no API key (recommended for the free stack).
EMBEDDER_BACKEND=sentence-transformers
# COHERE_API_KEY=
EMBEDDING_DIMENSION=384

# ── Simulation ────────────────────────────
# Seconds between turns — keeps the turn loop under free-tier LLM rate limits.
SIMULATION_TURN_DELAY_SECONDS=7

# ── Auth ──────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Keycloak ──────────────────────────────
# Browser-facing URL (used by client-side JS)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=nyayrithm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=nyayrithm-app
# Server-side URL for Next.js API routes.
# Docker: automatically set to http://keycloak:8080 in docker-compose.yml
# Local bun dev: set to http://localhost:8080 in frontend/.env.local (created by `make env`)
KEYCLOAK_URL=http://localhost:8080
# Master-realm admin credentials (server-side only — never expose to browser)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASS=admin

# ── Frontend (Next.js) ────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Bypass Keycloak auth for local dev (skip the login wall on /dashboard/*)
NEXT_PUBLIC_DEV_MODE=true

# ── Public site topology ──────────────────
# The project runs on two domains in production:
#   MARKETING_URL — the public landing page and docs, indexed for search
#   APP_URL       — where people sign in and run proceedings (the AI app)
# Both can point at the same Next.js deployment, or the marketing routes
# (/, /docs) can be deployed separately. Locally, leave these unset and the
# app falls back to same-origin relative links.
NEXT_PUBLIC_MARKETING_URL=https://nyayrithm.aayushjoshi.dev
NEXT_PUBLIC_APP_URL=https://nyayrithm.ai.aayushjoshi.dev
